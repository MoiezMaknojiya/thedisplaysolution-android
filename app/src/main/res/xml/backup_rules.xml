<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6 to 11's backup, which reads this instead of data_extraction_rules.xml: nothing either, for the same
     reason — the pairing token lives in the WebView's storage. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>

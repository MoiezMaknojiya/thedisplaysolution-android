# Copy this file to keystore.properties (git-ignored, never committed) and fill it in, so that
# "gradlew assembleSiteRelease bundlePlayRelease" signs with the release key. See docs/release-guide/index.html.
# The key itself stays outside the project; a Windows path is written with forward slashes.
storeFile=D:/Keys/the-display-solution-release.jks
storePassword=
keyAlias=
keyPassword=
